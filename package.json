{
  "name": "thaura-ai-technical-testing",
  "private": true,
  "scripts": {
    "test": "npx playwright test",
    "test:task01": "npx playwright test tests/task01",
    "test:task02": "npx playwright test tests/task02",
    "test:report": "npx playwright show-report",
    "auth:login": "node scripts/thaura-login.js",
    "load:k6:min": "k6 run load/k6-minimum.js",
    "load:k6:min:report": "k6 run --summary-export=reports/task02/k6-minimum-summary.json load/k6-minimum.js && node scripts/render-k6-report.js",
    "report:task02:html": "node scripts/render-task-report.js reports/task02/TASK-02-BUG-REPORT.md reports/task02/TASK-02-BUG-REPORT.html",
    "report:task01:html": "node scripts/render-task-report.js reports/task01/TASK-01-REPORT.md reports/task01/TASK-01-REPORT.html",
    "report:bug-register": "node scripts/generate-bug-report-xlsx.js",
    "test:compatibility": "npx playwright test --config=playwright.compat.config.ts",
    "lighthouse:home": "lighthouse https://thaura.ai --chrome-flags=\"--headless --no-sandbox\" --output=json --output-path=./reports/task02/lighthouse-home.json --only-categories=performance,best-practices,seo,accessibility",
    "lighthouse:pricing": "lighthouse https://thaura.ai/pricing --chrome-flags=\"--headless --no-sandbox\" --output=json --output-path=./reports/task02/lighthouse-pricing.json --only-categories=performance,best-practices,seo,accessibility",
    "lighthouse:faq": "lighthouse https://thaura.ai/faq --chrome-flags=\"--headless --no-sandbox\" --output=json --output-path=./reports/task02/lighthouse-faq.json --only-categories=performance,best-practices,seo,accessibility",
    "lighthouse:api": "lighthouse https://thaura.ai/api --chrome-flags=\"--headless --no-sandbox\" --output=json --output-path=./reports/task02/lighthouse-api.json --only-categories=performance,best-practices,seo,accessibility",
    "lighthouse:all": "npm run lighthouse:home && npm run lighthouse:pricing && npm run lighthouse:faq && npm run lighthouse:api"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "lighthouse": "^12.8.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "googleapis": "^180.0.0",
    "marked": "^18.0.13",
    "nunjucks": "^3.2.4",
    "xlsx": "^0.18.5"
  }
}
